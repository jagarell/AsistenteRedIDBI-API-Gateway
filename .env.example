# Variables de entorno del gateway IDBI.
# Copia este archivo a .env (ignorado por git) y complétalo con valores reales
# del gestor de secretos corporativo. NUNCA subas .env al repositorio.

# --- Base de datos PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/asistente_red_idbi
DB_USERNAME=idbi_user
DB_PASSWORD=cambia-esto-por-un-secreto-del-vault

# --- Seguridad / JWT ---
# Debe tener al menos 32 caracteres. Genera uno seguro, por ejemplo:
#   openssl rand -base64 48
JWT_SECRET=cambia-esto-por-una-clave-de-al-menos-32-bytes
JWT_EXPIRATION_MINUTES=60

# --- Integración con FastAPI (motor de chat/análisis) ---
FASTAPI_BASE_URL=http://localhost:8000

# --- CORS (orígenes permitidos, coma-separados). En producción restringir. ---
CORS_ALLOWED_ORIGINS=*

# --- JPA (opcional) ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
