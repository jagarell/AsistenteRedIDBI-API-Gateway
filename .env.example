# Variables de entorno del gateway IDBI.
# Copia este archivo a .env (ignorado por git) y complétalo con valores reales
# del gestor de secretos corporativo. NUNCA subas .env al repositorio.

# --- Base de datos PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/asistente_red_idbi
DB_USERNAME=idbi_user
DB_PASSWORD=cambia-esto-por-un-secreto-del-vault

# --- Seguridad / JWT ---
# Debe tener al menos 32 caracteres. Genera uno seguro, por ejemplo:
#   openssl rand -base64 48
JWT_SECRET=cambia-esto-por-una-clave-de-al-menos-32-bytes
JWT_EXPIRATION_MINUTES=60

# --- Integración con FastAPI (motor de chat/análisis) ---
FASTAPI_BASE_URL=http://localhost:8000

# --- Firebase Cloud Messaging (notificaciones push) ---
# Ruta al JSON de la cuenta de servicio descargado desde Firebase Console
# (Configuración del proyecto -> Cuentas de servicio -> Generar nueva clave
# privada). Nunca subir este archivo al repositorio.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# --- CORS (orígenes permitidos, coma-separados). En producción restringir. ---
CORS_ALLOWED_ORIGINS=*

# --- JPA (opcional) ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# --- Correo (recuperación de contraseña, envío de propuestas) ---
# Deshabilitado por defecto: si MAIL_ENABLED=false, nunca se intenta
# conectar a un SMTP y las operaciones que requieren correo fallan con un
# mensaje claro en vez de simular éxito.
MAIL_ENABLED=false
MAIL_HOST=smtp.tudominio.com
MAIL_PORT=587
MAIL_USERNAME=cambia-esto
MAIL_PASSWORD=cambia-esto-por-un-secreto-del-vault
MAIL_FROM=no-reply@idbi.pe

# --- Validación de RUC/negocio (APIs Peru, apis.net.pe) ---
# Deshabilitado por defecto: sin RUC_VALIDATION_ENABLED=true y una API key
# real, solo se aplica una validación de formato local del nombre del
# negocio (nunca simula una validación real exitosa).
RUC_VALIDATION_ENABLED=false
RUC_VALIDATION_API_KEY=
